# Private local configuration (only the placeholder example is versioned)
/private/config*.php
!/private/config.example.php

# Runtime session files. The directory is created on the server, never deployed from Git.
/private/sessions/

# Written on the server at deploy time. It only stores a directory path.
/public/private-path.php

# Source documents supplied for local drafting. Never commit them.
/uploads/
*.docx
.env
.env.*
!.env.example

# Local archives, backups and distribution packages
/.local/
/backups/
*.zip
*.bak
*.old
*.tmp

# Logs, editor state and OS metadata
*.log
/.vscode/
/.idea/
desktop.ini
Thumbs.db
.DS_Store

# Test/runtime artifacts
__pycache__/
*.py[cod]
/coverage/
.phpunit.cache/
